# Modèle de configuration locale. Aucune valeur réelle ici.
# Créer le vrai fichier avec :  python scripts/dev/dev.py init-env
# (la commande génère des mots de passe aléatoires dans .env, jamais versionné et jamais affiché).
# Copie manuelle possible (cp .env.example .env  /  Copy-Item .env.example .env), mais alors
# remplacer chaque « change-me-local » par une valeur propre à ce poste.

ENVIRONMENT=local

# --- PostgreSQL 16 -----------------------------------------------------------
# Compte administrateur : migrations et sauvegardes seulement, jamais utilisé par un service.
POSTGRES_USER=novaria_admin
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=novaria
POSTGRES_PORT=5432
# Un rôle par service, limité à son schéma (ADR-024)
PG_PASSWORD_APP=change-me-local
PG_PASSWORD_TRAITEMENT=change-me-local
PG_PASSWORD_ALERTE=change-me-local
PG_PASSWORD_LECTURE=change-me-local

# --- MongoDB 7 ---------------------------------------------------------------
MONGO_ROOT_USER=mongo_admin
MONGO_ROOT_PASSWORD=change-me-local
MONGO_DB=novaria
MONGO_PORT=27017
# Un utilisateur par service, avec les seuls droits utiles sur ses collections (ADR-024)
MONGO_PASSWORD_COLLECTE=change-me-local
MONGO_PASSWORD_TRAITEMENT=change-me-local
MONGO_PASSWORD_REPONSE=change-me-local
MONGO_PASSWORD_BACKEND=change-me-local
MONGO_PASSWORD_ML=change-me-local
# Durées de conservation (secondes) : 14 jours pour les événements bruts, 30 jours pour les rejets
RAW_EVENTS_TTL_SECONDS=1209600
REJECTS_TTL_SECONDS=2592000

# --- Sauvegardes locales -----------------------------------------------------
BACKUP_KEEP=7

# --- Application -------------------------------------------------------------
JWT_SECRET=change-me-local-at-least-32-characters
