# Modèle de configuration locale. Aucune valeur réelle ici.
# Créer le vrai fichier avec :  python scripts/dev/dev.py init-env
# (la commande génère des mots de passe aléatoires dans .env, jamais versionné et jamais affiché).
# Copie manuelle possible (cp .env.example .env  /  Copy-Item .env.example .env), mais alors
# remplacer chaque « change-me-local » par une valeur propre à ce poste.

ENVIRONMENT=local

# --- PostgreSQL 16 -----------------------------------------------------------
# Compte administrateur : migrations et sauvegardes seulement, jamais utilisé par un service.
POSTGRES_USER=novaria_admin
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=novaria
POSTGRES_PORT=5432
# Un rôle par service, limité à son schéma (ADR-024)
PG_PASSWORD_APP=change-me-local
PG_PASSWORD_TRAITEMENT=change-me-local
PG_PASSWORD_ALERTE=change-me-local
PG_PASSWORD_LECTURE=change-me-local

# --- MongoDB 7 ---------------------------------------------------------------
MONGO_ROOT_USER=mongo_admin
MONGO_ROOT_PASSWORD=change-me-local
MONGO_DB=novaria
MONGO_PORT=27017
# Un utilisateur par service, avec les seuls droits utiles sur ses collections (ADR-024)
MONGO_PASSWORD_COLLECTE=change-me-local
MONGO_PASSWORD_TRAITEMENT=change-me-local
MONGO_PASSWORD_REPONSE=change-me-local
MONGO_PASSWORD_BACKEND=change-me-local
MONGO_PASSWORD_ML=change-me-local
# Durées de conservation (secondes) : 14 jours pour les événements bruts, 30 jours pour les rejets
RAW_EVENTS_TTL_SECONDS=1209600
REJECTS_TTL_SECONDS=2592000

# --- Kafka (mode KRaft, un seul broker ; ADR-009) -----------------------------
# Port publié sur 127.0.0.1 pour les clients lancés depuis le poste ; les conteneurs utilisent kafka:9092.
KAFKA_PORT=9094

# --- Traitement en flux (MS-09) -----------------------------------------------------
# true : rejeu d'un jeu historique (les horodatages passés sont la règle, le futur n'est plus refusé).
FLUX_REPLAY=false

# --- Service d'alerte (MS-11) -------------------------------------------------------
# Canal de la notification simulée : « log » (une ligne de journal) ou « webhook » (POST JSON vers ALERT_WEBHOOK_URL).
ALERT_NOTIFICATION_CHANNEL=log
# Adresse du webhook, avec son éventuel jeton dans le chemin : un secret, à ne jamais versionner (laisser vide ici).
ALERT_WEBHOOK_URL=

# --- Ports publiés sur 127.0.0.1 (changer l'un d'eux si un autre programme du poste l'occupe) -----------
GATEWAY_PORT=8000
FRONTEND_PORT=8080
COLLECTE_PORT=8001
TRAITEMENT_PORT=8002
ALERTE_PORT=8003
REPONSE_PORT=8004
SIMULATOR_PORT=8005
# Niveau des journaux JSON des services : DEBUG, INFO, WARNING, ERROR ou CRITICAL
LOG_LEVEL=INFO

# --- Sauvegardes locales -----------------------------------------------------
BACKUP_KEEP=7

# --- Application -------------------------------------------------------------
JWT_SECRET=change-me-local-at-least-32-characters

# --- Robot du rapport hebdomadaire (IA-07) : compte de service en LECTURE SEULE de l'API ---------------
# `init-env` génère le mot de passe. Créer ensuite le compte avec ce même mot de passe (copié depuis .env) :
# python3 scripts/dev/dev.py user-create rpa-rapport --role viewer
NOVARIA_RPA_USER=rpa-rapport
NOVARIA_RPA_PASSWORD=change-me-local
# Facultatif, jamais obligatoire. Reprises si l'API est occupée (3 tentatives, 60 s doublées à chaque échec par défaut) :
# NOVARIA_RPA_TENTATIVES=3
# NOVARIA_RPA_ATTENTE_S=60
# Facultatif. Courriel de notification en plus du journal var/reports/notifications.log (désactivé tant que NOVARIA_RPA_SMTP est vide).
# Serveur d'essai local : 127.0.0.1:1025. Tout autre serveur doit offrir STARTTLS. Un compte (utilisateur + mot de passe) ne s'écrit
# que dans votre .env, jamais ici :
# NOVARIA_RPA_SMTP=127.0.0.1:1025
# NOVARIA_RPA_DESTINATAIRE=equipe@example.org
# NOVARIA_RPA_EXPEDITEUR=novaria-rpa@localhost

# --- Surveillance de la dérive des entrées du modèle de prévision (IA-06) : aucun n'est un secret ------
# Exécution de référence (le jeu d'entraînement) à laquelle la plus récente est comparée. Vide : /metrics
# répond NO_REFERENCE et aucune alerte ne se déclenche. Seuils de PSI : avertissement 0.10, alerte 0.25.
DRIFT_REFERENCE_RUN_ID=

# --- Sécurité applicative (BE-08) : réglages, aucun n'est un secret ------------------------------
# Origines de navigateur autorisées à lire les réponses de l'API (CORS), séparées par des virgules.
# Une origine exacte (schéma://hôte:port, sans chemin) ; jamais « * ». Vide : aucune origine.
# Adapter le port si FRONTEND_PORT change. Le front-end du dépôt appelle l'API par la même origine
# (proxy de Vite ou de nginx) : CORS ne sert qu'à un front-end servi depuis une autre adresse.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173
# Limitation de la connexion : essais par minute et par adresse, puis échecs tolérés par identifiant
# (blocage pour LOGIN_LOCKOUT_S secondes ; la limite se desserre quand le plus ancien échec en sort)
LOGIN_ATTEMPTS_PER_MINUTE=10
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_S=900
# Relais de confiance devant le service de traitement : 1 = la passerelle (adresse du client lue
# dans X-Forwarded-For), 0 = appel direct (en-tête ignoré, impossible à falsifier)
TRUSTED_PROXY_HOPS=1
