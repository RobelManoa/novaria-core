{
  "name": "novaria-core-citoyen",
  "private": true,
  "version": "0.1.0",
  "description": "Application citoyenne (PoC) : l'état de la circulation, sans compte, en lecture seule (ADR-030, CIT-04).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
